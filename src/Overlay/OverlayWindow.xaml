<Window x:Class="MsfsAiAtc.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MsfsAiAtc.Overlay"
        Title="AI ATC"
        Width="560" Height="460"
        MinWidth="420" MinHeight="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Left="20" Top="20">

    <Window.Resources>
        <!-- Minimalist opaque palette — radar/military aesthetic, no gradients, no transparency -->
        <SolidColorBrush x:Key="WinBg"        Color="#FF0C1014"/>  <!-- near-black slate, fully opaque -->
        <SolidColorBrush x:Key="HeaderBg"     Color="#FF090C10"/>  <!-- darkest row -->
        <SolidColorBrush x:Key="ChatBg"       Color="#FF0E1218"/>  <!-- chat area, 1 shade up -->
        <SolidColorBrush x:Key="InfoBg"       Color="#FF090C10"/>  <!-- info bar matches header -->
        <SolidColorBrush x:Key="FooterBg"     Color="#FF070A0E"/>  <!-- footer, darkest -->
        <SolidColorBrush x:Key="PilotBubble"  Color="#FF131D2E"/>  <!-- solid dark navy for pilot -->
        <SolidColorBrush x:Key="AtcBubble"    Color="#FF0E1C14"/>  <!-- solid dark green for ATC -->
        <SolidColorBrush x:Key="PilotFg"      Color="#FFD0DCFF"/>  <!-- pilot text: cool white-blue -->
        <SolidColorBrush x:Key="AtcFg"        Color="#FFCCE8D8"/>  <!-- ATC text: cool white-green -->
        <SolidColorBrush x:Key="PilotPrefix"  Color="#FF4A80FF"/>  <!-- pilot label: electric blue -->
        <SolidColorBrush x:Key="AtcPrefix"    Color="#FF3DBF7A"/>  <!-- ATC label: solid green -->
        <SolidColorBrush x:Key="MutedFg"      Color="#FF3A4455"/>  <!-- inactive elements -->
        <SolidColorBrush x:Key="SubtleFg"     Color="#FF556070"/>  <!-- secondary labels -->
        <SolidColorBrush x:Key="AccentBlue"   Color="#FF4A80FF"/>  <!-- pilot accent -->
        <SolidColorBrush x:Key="AccentGreen"  Color="#FF3DBF7A"/>  <!-- ATC / connected accent -->
        <SolidColorBrush x:Key="AccentAmber"  Color="#FFFF9500"/>  <!-- warning / recording -->
        <SolidColorBrush x:Key="AccentRed"    Color="#FFFF4444"/>  <!-- error / disconnected -->
        <SolidColorBrush x:Key="ChipBg"       Color="#FF111620"/>  <!-- info chip background -->
        <SolidColorBrush x:Key="ChipBorder"   Color="#FF1C2535"/>  <!-- info chip border -->
        <FontFamily x:Key="Ui">Segoe UI, Arial</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Code, Consolas, Courier New</FontFamily>

        <!-- Info chip style (used in the bottom bar) -->
        <Style x:Key="InfoChip" TargetType="Border">
            <Setter Property="Background"     Value="{StaticResource ChipBg}"/>
            <Setter Property="BorderBrush"    Value="{StaticResource ChipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Padding"        Value="12,6"/>
            <Setter Property="Margin"         Value="4,0"/>
        </Style>

        <!-- Label above chip value -->
        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="{StaticResource Ui}"/>
            <Setter Property="FontSize"     Value="8"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{StaticResource SubtleFg}"/>
            <Setter Property="Margin"       Value="0,0,0,1"/>
        </Style>

        <!-- Value inside chip -->
        <Style x:Key="ChipValue" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="{StaticResource Mono}"/>
            <Setter Property="FontSize"     Value="15"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Foreground"   Value="{StaticResource AccentBlue}"/>
        </Style>
    </Window.Resources>

    <!-- Root border — solid, no shadow, no blur -->
    <Border CornerRadius="12"
            Background="{StaticResource WinBg}"
            BorderBrush="#FF1C2535"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- title bar -->
                <RowDefinition Height="*"/>     <!-- chat ONLY -->
                <RowDefinition Height="Auto"/>  <!-- BeyondATC-style info chips -->
                <RowDefinition Height="Auto"/>  <!-- status footer -->
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBg}"
                    CornerRadius="12,12,0,0"
                    MouseDown="TitleBar_MouseDown"
                    Cursor="SizeAll"
                    Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✈" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"
                                   Foreground="{StaticResource AccentBlue}"/>
                        <TextBlock Text="AI" FontFamily="{StaticResource Ui}" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                        <TextBlock Text=" ATC" FontFamily="{StaticResource Ui}" FontSize="13" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Phase chip (centre) -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#FF111820" CornerRadius="4" Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PhaseChip" Text="Ground"
                                       FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlue}"/>
                            <TextBlock x:Name="FreqChip" Text=""
                                       FontFamily="{StaticResource Mono}" FontSize="11"
                                       Foreground="{StaticResource AccentGreen}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Sim status dot -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse x:Name="SimDot" Width="7" Height="7" Margin="0,0,5,0">
                            <Ellipse.Fill><SolidColorBrush x:Name="SimDotBrush" Color="#FFFF5555"/></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="SimStatusText" Text="SIM: Disconnected"
                                   FontFamily="{StaticResource Ui}" FontSize="9"
                                   Foreground="{StaticResource SubtleFg}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close -->
                    <Button Grid.Column="3" x:Name="CloseBtn" Content="✕"
                            FontSize="11" Cursor="Hand"
                            Foreground="{StaticResource MutedFg}"
                            Click="CloseBtn_Click" Padding="6,2">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"    Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#33FF5555"/>
                                                    <Setter Property="Foreground" Value="#FFFF5555"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ CHAT — full height, ONLY pilot+ATC bubbles ════════════════ -->
            <Border Grid.Row="1" Background="{StaticResource ChatBg}" Padding="10,8">
                <ScrollViewer x:Name="ChatScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <ItemsControl x:Name="ChatLog">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ChatEntry}">
                                <Grid Margin="0,4">
                                    <Border Padding="12,8" CornerRadius="10"
                                            MaxWidth="420">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"          Value="{StaticResource AtcBubble}"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPilot}" Value="True">
                                                        <Setter Property="Background"          Value="{StaticResource PilotBubble}"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- Role label: "YOU" or "GROUND" etc -->
                                            <TextBlock Text="{Binding Prefix}"
                                                       FontFamily="{StaticResource Ui}"
                                                       FontSize="8" FontWeight="Bold"
                                                       Foreground="{Binding PrefixColor}"
                                                       Margin="0,0,0,3"
                                                       Visibility="{Binding PrefixVisibility}"/>
                                            <!-- Message text -->
                                            <TextBlock Text="{Binding Text}"
                                                       FontFamily="{StaticResource Ui}"
                                                       FontSize="12.5"
                                                       Foreground="{Binding TextColor}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ═══ INFO BAR — BeyondATC style chips ══════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{StaticResource InfoBg}"
                    BorderBrush="#FF1C2535" BorderThickness="0,1,0,1"
                    Padding="8,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Runway chip -->
                    <Border Grid.Column="0" Style="{StaticResource InfoChip}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="ACTIVE RWY" Style="{StaticResource ChipLabel}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="RunwayChip" Text="---"
                                       Style="{StaticResource ChipValue}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Squawk chip -->
                    <Border Grid.Column="1" Style="{StaticResource InfoChip}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SQUAWK" Style="{StaticResource ChipLabel}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SquawkChip" Text="----"
                                       Style="{StaticResource ChipValue}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Frequency chip -->
                    <Border Grid.Column="2" Style="{StaticResource InfoChip}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="FREQUENCY" Style="{StaticResource ChipLabel}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FreqValue" Text="---.-"
                                       Style="{StaticResource ChipValue}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Callsign chip -->
                    <Border Grid.Column="3" Style="{StaticResource InfoChip}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CALLSIGN" Style="{StaticResource ChipLabel}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CallsignChip" Text="------"
                                       Style="{StaticResource ChipValue}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ STATUS FOOTER ══════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="{StaticResource FooterBg}"
                    CornerRadius="0,0,12,12"
                    Padding="12,7"
                    BorderBrush="#FF1C2535" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Voice state dot + label -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StateDot" Width="8" Height="8" Margin="0,0,7,0">
                            <Ellipse.Fill><SolidColorBrush x:Name="StateDotBrush" Color="#33334DA6"/></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="StateLabel" Text="IDLE"
                                   FontFamily="{StaticResource Mono}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedFg}"/>
                    </StackPanel>

                    <!-- SIM altitude/speed when connected -->
                    <TextBlock Grid.Column="1" x:Name="SimDetailText" Text=""
                               FontFamily="{StaticResource Mono}" FontSize="9"
                               Foreground="{StaticResource MutedFg}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- PTT key hint -->
                    <Border Grid.Column="2" x:Name="PttIndicator"
                            CornerRadius="4" Padding="10,3"
                            BorderThickness="1" BorderBrush="#FF1C2535"
                            Background="Transparent">
                        <TextBlock x:Name="PttLabel" Text="CAPS  PTT"
                                   FontFamily="{StaticResource Mono}"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource MutedFg}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
