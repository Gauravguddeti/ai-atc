<Window x:Class="MsfsAiAtc.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MsfsAiAtc.Overlay"
        Title="MSFS AI ATC"
        Width="520" Height="420"
        MinWidth="380" MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Left="20" Top="20">

    <Window.Resources>
        <!-- Core palette (SayIntentions-inspired dark theme) -->
        <SolidColorBrush x:Key="WinBg"         Color="#E6141820"/>
        <SolidColorBrush x:Key="HeaderBg"      Color="#FF0F1117"/>
        <SolidColorBrush x:Key="InfoBg"        Color="#FF181C26"/>
        <SolidColorBrush x:Key="ChatBg"        Color="#FF111318"/>
        <SolidColorBrush x:Key="FooterBg"      Color="#FF0F1117"/>
        <SolidColorBrush x:Key="PilotBubble"   Color="#FF5B4FCF"/>   <!-- purple like SayIntentions pilot -->
        <SolidColorBrush x:Key="AtcBubble"     Color="#FF1B3A2E"/>   <!-- dark green for ATC -->
        <SolidColorBrush x:Key="SysFg"         Color="#FF6677AA"/>
        <SolidColorBrush x:Key="PilotFg"       Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="AtcFg"         Color="#FFD4F0E0"/>
        <SolidColorBrush x:Key="AccentGreen"   Color="#FF4CAF82"/>
        <SolidColorBrush x:Key="AccentPurple"  Color="#FF7C6FF7"/>
        <SolidColorBrush x:Key="AccentAmber"   Color="#FFFFCD8A"/>
        <SolidColorBrush x:Key="AccentRed"     Color="#FFFF5555"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#FF8899BB"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#FFE8EAF6"/>
        <FontFamily x:Key="Ui">Segoe UI, Arial</FontFamily>
        <FontFamily x:Key="Mono">Cascadia Code, Consolas, Courier New</FontFamily>

        <!-- Frequency chip style -->
        <Style x:Key="FreqChip" TargetType="Border">
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Margin"          Value="4,0,0,0"/>
            <Setter Property="Background"      Value="#FF1E2230"/>
        </Style>
    </Window.Resources>

    <!-- Root glass border -->
    <Border CornerRadius="10"
            Background="{StaticResource WinBg}"
            BorderBrush="#44FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000" BlurRadius="28" ShadowDepth="0" Opacity="0.75"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- drag / title bar -->
                <RowDefinition Height="Auto"/>  <!-- COM freq chips -->
                <RowDefinition Height="Auto"/>  <!-- airport info -->
                <RowDefinition Height="*"/>     <!-- chat log -->
                <RowDefinition Height="Auto"/>  <!-- PTT footer -->
            </Grid.RowDefinitions>

            <!-- ═══ DRAG / TITLE BAR ═══════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBg}"
                    CornerRadius="10,10,0,0"
                    MouseDown="TitleBar_MouseDown"
                    Cursor="SizeAll"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Headset icon + brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎧" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="AI" FontFamily="{StaticResource Ui}" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center"/>
                        <TextBlock Text=" ATC" FontFamily="{StaticResource Ui}" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- SimConnect dot + status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="SimDot" Width="8" Height="8" Margin="0,0,6,0"
                                 Fill="{StaticResource AccentRed}"/>
                        <TextBlock x:Name="SimStatusText" Text="SIM: Disconnected"
                                   FontFamily="{StaticResource Ui}" FontSize="10"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="2" x:Name="CloseBtn" Content="✕"
                            FontSize="12" Cursor="Hand"
                            Foreground="{StaticResource TextMuted}"
                            Click="CloseBtn_Click" Padding="6,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"   Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#33FF5555"/>
                                                    <Setter Property="Foreground" Value="#FF5555"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ COM FREQUENCY CHIPS ══════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="{StaticResource HeaderBg}"
                    Padding="10,5" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Active freq chip -->
                    <Border Style="{StaticResource FreqChip}" Background="#FF2D3250">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ControllerLabel" Text="Ground"
                                       FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FreqLabel" Text=""
                                       FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentGreen}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Airport chip -->
                    <Border Style="{StaticResource FreqChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OPDB " FontSize="9" Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource Ui}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AirportLabel" Text="---"
                                       FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- PTT key hint -->
                    <Border Style="{StaticResource FreqChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PTT " FontSize="9" Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource Ui}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PttKeyHint" Text="[CAPS]"
                                       FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentAmber}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ CHAT LOG ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="{StaticResource ChatBg}" Padding="8,6">
                <ScrollViewer x:Name="ChatScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <ItemsControl x:Name="ChatLog">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ChatEntry}">
                                <!-- Each row is a full-width Grid so bubbles can align left or right -->
                                <Grid Margin="0,3">
                                    <Border x:Name="BubbleBorder"
                                            Padding="10,7" CornerRadius="8"
                                            MaxWidth="370" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource AtcBubble}"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPilot}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PilotBubble}"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Prefix}"
                                                       FontFamily="{StaticResource Ui}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding PrefixColor}"
                                                       Margin="0,0,0,2"
                                                       Visibility="{Binding PrefixVisibility}"/>
                                            <TextBlock Text="{Binding Text}"
                                                       FontFamily="{StaticResource Ui}"
                                                       FontSize="12"
                                                       Foreground="{Binding TextColor}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ═══ PTT FOOTER ═══════════════════════════════════════════════════ -->
            <Border Grid.Row="4"
                    Background="{StaticResource FooterBg}"
                    CornerRadius="0,0,10,10"
                    Padding="10,7"
                    BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- State indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StateDot" Width="10" Height="10" Margin="0,0,8,0">
                            <Ellipse.Fill>
                                <SolidColorBrush x:Name="StateDotBrush" Color="#334DA6FF"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="StateLabel" Text="IDLE"
                                   FontFamily="{StaticResource Mono}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>

                    <!-- PTT badge -->
                    <Border Grid.Column="1" x:Name="PttIndicator"
                            CornerRadius="5" Padding="10,4"
                            BorderThickness="1" BorderBrush="#334DA6FF"
                            Background="Transparent">
                        <TextBlock x:Name="PttLabel" Text="PTT"
                                   FontFamily="{StaticResource Mono}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
