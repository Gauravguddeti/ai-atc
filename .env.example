# Copy this file to .env and fill in your values.
# The .env file is NEVER committed to git (it's in .gitignore).

GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_API_KEY_2=your_fallback_groq_api_key_here

PUSH_TO_TALK_KEY=CapsLock
MIC_DEVICE_ID=
OUTPUT_DEVICE_ID=
PIPER_VOICE=en_US-lessac-medium
LOG_LEVEL=info

# OPTIONAL: If the app cannot automatically find your MSFS installation
# (e.g. cracked/repack version), uncomment this and set it to the folder
# that contains your "Community" and "Official" folders.
# MSFS_PACKAGES_PATH=C:\MSFS\Packages
